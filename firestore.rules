rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && request.auth.uid == "niWBY7pf8FbJG76yqsv219dMEdR2";
    }
    match /usernames/{usernameKey} {
      allow read: if signedIn();
      allow create: if signedIn()
        && !exists(/databases/$(database)/documents/usernames/$(usernameKey))
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username is string;
      allow update, delete: if false;
    }
    match /users/{userId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username is string
        && request.resource.data.usernameLower is string
        && request.resource.data.badgeId is string
        && request.resource.data.badgeIcon is string
        && request.resource.data.badgeLabel is string
        && request.resource.data.email == request.auth.token.email
        && !exists(/databases/$(database)/documents/users/$(userId));
      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['username', 'usernameLower', 'badgeId', 'badgeIcon', 'badgeLabel']);
      allow delete: if isAdmin();
    }
    match /games/{gameId} {
      allow read: if signedIn();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        signedIn()
        && resource.data.status == "waiting"
        && request.resource.data.status == resource.data.status
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["players"])
        && resource.data.players is list
        && request.resource.data.players is list
        && resource.data.capacity is int
        && resource.data.players.size() < resource.data.capacity
        && request.resource.data.players.size() == resource.data.players.size() + 1
        && request.resource.data.players.hasAll(resource.data.players)
        && request.resource.data.players[request.resource.data.players.size() - 1].uid == request.auth.uid
      );
    }
    match /{document=**} { allow read, write: if false; }
  }
}