rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return signedIn() && request.auth.uid == "ADMIN_UID_BURAYA";
    }

    // Kullanıcı adları kayıt sırasında bir kez rezerve edilir; herkes okuyabilir,
    // ancak yalnızca giriş yapan kullanıcı kendi adına yeni rezervasyon yapabilir.
    match /usernames/{usernameKey} {
      allow read: if true;
      allow create: if signedIn()
        && !exists(/databases/$(database)/documents/usernames/$(usernameKey))
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username is string;
      allow update, delete: if false;
    }

    // Profil bilgileri giriş yapan kullanıcılara okunabilir; kullanıcı yalnızca
    // kendi profilini ilk kez oluşturabilir. Arma ve kullanıcı adı sonradan değiştirilemez.
    match /users/{userId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username is string
        && request.resource.data.usernameLower is string
        && request.resource.data.badgeId is string
        && request.resource.data.badgeIcon is string
        && request.resource.data.email == request.auth.token.email
        && !exists(/databases/$(database)/documents/users/$(userId));
      allow update, delete: if false;
    }

    // Oyun odaları sonraki aşamada eklenecek. Yönetici dışındaki kullanıcılar
    // oda oluşturma/iptal etme yetkisine sahip olmayacak.
    match /games/{gameId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
