rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.uid == "niWBY7pf8FbJG76yqsv219dMEdR2"; }
    function isRoomMember(roomData) { return signedIn() && request.auth.uid in roomData.memberOrder; }
    function roomExists(roomId) { return exists(/databases/$(database)/documents/rooms/$(roomId)); }
    function roomFinished(roomId) { return roomExists(roomId) && get(/databases/$(database)/documents/rooms/$(roomId)).data.status == 'finished'; }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow create, update: if signedIn() && request.auth.uid == userId;
      allow delete: if isAdmin();
    }

    match /rooms/{roomId} {
      allow read: if signedIn();
      // Only the configured administrator may create a room.
      allow create: if isAdmin()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == 'waiting'
        && request.resource.data.memberOrder is list
        && request.resource.data.memberOrder.size() == 1;
      // Admin controls status changes/closure. Members may only change game-state fields
      // while keeping room status and owner unchanged.
      allow update: if isAdmin() || (
        // A visitor may join only a waiting room, without changing any other fields.
        signedIn()
        && resource.data.status == 'waiting'
        && resource.data.memberOrder.size() < resource.data.capacity
        && request.resource.data.memberOrder.hasAll(resource.data.memberOrder)
        && !(request.auth.uid in resource.data.memberOrder)
        && request.auth.uid in request.resource.data.memberOrder
        && request.resource.data.memberOrder.size() == resource.data.memberOrder.size() + 1
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberOrder','members','updatedAt'])
      ) || (
        isRoomMember(resource.data)
        && (request.resource.data.status == resource.data.status
          || (resource.data.status == 'drafting' && request.resource.data.status == 'finished'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['picks','pendingPick','turnIndex','status','draftStage','lastSpin','lastPickAnnouncement','updatedAt']))
          || (resource.data.status == 'waiting' && request.resource.data.status == 'drafting'
            && request.auth.uid == resource.data.ownerUid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','turnIndex','picks','pendingPick','protectionRights','protectionRightsEarned','swapRights','swapRightsEarned','lastPickAnnouncement','updatedAt'])))
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'picks','pendingPick','turnIndex','status','draftStage','lastSpin','protectionRights','swapRights',
          'protectionRightsEarned','swapRightsEarned','lastPickAnnouncement','tactics','league','updatedAt'
        ])
      );
      allow delete: if isAdmin();
    }

    // Protection selections are made after all rosters are complete.
    // A player can only write their own protection record.
    match /roomSecrets/{secretId} {
      allow read: if isAdmin() || (signedIn() && secretId.matches('.*_' + request.auth.uid))
        || (signedIn() && resource.data.uid == request.auth.uid)
        || (signedIn() && roomFinished(resource.data.roomId)
          && request.auth.uid in get(/databases/$(database)/documents/rooms/$(resource.data.roomId)).data.memberOrder);
      allow create, update: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.roomId is string
        && roomExists(request.resource.data.roomId)
        && request.auth.uid in get(/databases/$(database)/documents/rooms/$(request.resource.data.roomId)).data.memberOrder
        && get(/databases/$(database)/documents/rooms/$(request.resource.data.roomId)).data.status == 'finished'
        && request.resource.data.protectedIds is list
        && request.resource.data.protectedIds.size() <= 3;
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }
    match /{document=**} { allow read, write: if false; }
  }
}
